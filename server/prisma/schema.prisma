generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Better Auth core models
// Fields required by better-auth are marked with a comment.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  emailVerified      Boolean            @default(false) // required by better-auth
  name               String?
  image              String? // better-auth uses "image" (was avatarUrl)
  avatarUrl          String? // kept for backwards compat
  role               UserRole           @default(EXPLORER)
  subscriptionStatus SubscriptionStatus @default(FREE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  createdContent    Content[]      @relation("creator")
  progress          Progress[]
  facilitatedGroups StudentGroup[]
  submissions       Submission[]
  userBadges        UserBadge[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String? // required by better-auth
  userAgent String? // required by better-auth
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // required by better-auth
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// OAuth / credential accounts — required by better-auth
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

/// Email verification / password-reset tokens — required by better-auth
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// App-specific models
// ─────────────────────────────────────────────────────────────────────────────

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progress")
}

model Content {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  type         String
  tierRequired UserRole @default(EXPLORER)
  creatorId    String
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  creator      User     @relation("creator", fields: [creatorId], references: [id])

  @@map("content")
}

model StudentGroup {
  id            String   @id @default(cuid())
  name          String
  facilitatorId String
  createdAt     DateTime @default(now())
  facilitator   User     @relation(fields: [facilitatorId], references: [id])

  @@map("student_groups")
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String
  thumbnail    String?
  tierRequired UserRole @default(EXPLORER)
  createdAt    DateTime @default(now())
  badges       Badge[]
  modules      Module[]

  @@map("courses")
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int
  lessons  Lesson[]
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model Lesson {
  id       String  @id @default(cuid())
  moduleId String
  title    String
  order    Int
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  phases   Phase[]

  @@map("lessons")
}

model Phase {
  id          String         @id @default(cuid())
  lessonId    String
  type        StoryPhaseType
  title       String
  order       Int
  content     Json
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("phases")
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  phaseId   String
  fileUrl   String?
  videoUrl  String?
  content   String?
  feedback  String?
  createdAt DateTime @default(now())
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String?
  icon        String?
  courseId    String?
  createdAt   DateTime    @default(now())
  course      Course?     @relation(fields: [courseId], references: [id])
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  GUEST
  EXPLORER
  BUILDER
  CREATOR_ELITE
  FACILITATOR
  ADMIN
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum StoryPhaseType {
  STORY
  LOGIC
  BUILD
  IMPROVE
  PRESENT
  SCENARIO
  REQUIREMENTS
  CHALLENGE_EDITOR
  FEEDBACK
  PROPOSAL
  FACILITATOR_REVIEW
  MILESTONE
  FINAL_SUBMISSION
}
