# ─── Database ────────────────────────────────────────────────────────────────
# Connection string for your PostgreSQL database (Neon, Supabase, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kiddykode?schema=public"

# Required if using a connection pooler (Prisma Accelerate, Supabase pooler, etc.)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kiddykode?schema=public"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# Full URL of this API server
BETTER_AUTH_URL="http://localhost:3001"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Full URL of the frontend (used for CORS and trusted origins)
CLIENT_URL="http://localhost:5173"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
