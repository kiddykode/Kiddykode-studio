# DATABASE_URL: The connection string for your Prisma Postgres (Neon, Supabase, etc.)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kiddykode?schema=public"

# DIRECT_URL: Required if using a connection pooler (like Prisma Accelerate or Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kiddykode?schema=public"

# CLIENT_URL: The URL of your frontend dev server
CLIENT_URL="http://localhost:5173"

# PORT: The port your API server will run on
PORT=3001
